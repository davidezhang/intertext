{
  "name": "intertext-dev",
  "version": "0.1.1",
  "description": "Responsive inline media pills for the web, with React bindings and draggable text composition.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidezhang/intertext.git"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["intertext", "inline-media", "interactive-text", "web-components", "react"],
  "packageManager": "pnpm@10.11.1",
  "files": [
    "dist/lib",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/artifact-pill.d.ts",
      "import": "./dist/lib/artifact-pill.js"
    },
    "./react": {
      "types": "./dist/lib/react.d.ts",
      "import": "./dist/lib/react.js"
    }
  },
  "scripts": {
    "dev": "npm run build:release && vite --host 127.0.0.1",
    "build:lib": "vite build --config vite.lib.config.ts && vite build --config vite.lib.config.ts --mode react && tsc -p tsconfig.lib.json",
    "build:release": "npm run build:lib && node scripts/prepare-release.mjs",
    "build": "tsc --noEmit && npm run build:release && vite build",
    "prepack": "npm run build:lib",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:package": "node scripts/smoke-package.mjs",
    "check:release": "npm run build && npm test && npm run test:package"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "dialkit": "^2.0.2",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.468.0",
    "motion": "^13.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
