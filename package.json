{
  "name": "@design-components/artifact-pill",
  "version": "0.1.0",
  "description": "Responsive inline media pills for the web, with React bindings and draggable text composition.",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidezhang/intertext.git"
  },
  "type": "module",
  "private": true,
  "files": [
    "dist/lib",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/artifact-pill.d.ts",
      "import": "./dist/lib/artifact-pill.js"
    },
    "./react": {
      "types": "./dist/lib/react.d.ts",
      "import": "./dist/lib/react.js"
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
